# Groq API key used for answer generation. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Sentence-transformers model used to embed chunks and queries.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq-hosted chat model used to synthesise answers. llama-3.3-70b-versatile
# has been decommissioned by Groq and returns 404; check /v1/models for what your
# account can reach.
LLM_MODEL=openai/gpt-oss-120b

# Answer generation limits.
MAX_ANSWER_TOKENS=700
GROQ_TIMEOUT_S=30

# Chunking, in tokens.
CHUNK_SIZE_TOKENS=180
CHUNK_OVERLAP_TOKENS=40

# Number of chunks retrieved per question.
TOP_K=5

# Retrieved chunks scoring below this are dropped instead of being sent to the LLM.
MIN_SIMILARITY=0.25

# Where runtime state lives. All of these sit under the gitignored data/ directory.
DATA_DIR=data
METRICS_PATH=data/metrics.jsonl

# On-disk locations (both live under the gitignored data/ directory).
CHROMA_PATH=data/chroma
SQLITE_PATH=data/metadata.db

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=20

# Load the embedding model at startup rather than on the first upload.
WARM_START=true
